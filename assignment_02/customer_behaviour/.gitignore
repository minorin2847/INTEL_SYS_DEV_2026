# ============================ customer_behaviour app ============================

# --- python ---
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# --- web (React + Vite) ---
web/node_modules/
web/dist/
web/dist-ssr/
web/*.local
*.log

# --- mobile (Flutter) — platform folders are regenerated by `flutter create .` ---
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/android/
mobile/ios/
mobile/linux/
mobile/macos/
mobile/windows/
mobile/web/

# --- scratch / OS junk ---
.tmp
*.tmp
.DS_Store
Thumbs.db

# --- keep the graded model artifacts ---
# The repo-root .gitignore ignores *.joblib and *.pkl everywhere; re-include the
# files that make up the persisted, gradable pipeline + its explainer.
!model/model_pipeline.joblib
!model/feature_names.joblib
!model/feature_means.joblib
!model/input_schema.json
